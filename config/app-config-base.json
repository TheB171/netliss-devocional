EAN", "userId": null, "value": true}, {"id": "192164", "label": "Ativar dialog de notificações", "name": "APP_DIALOG_NOTIFICATION_ENABLED", "type": "BOOLEAN", "userId": null, "value": true}, {"id": "41876", "label": "Ativar toast de sucesso", "name": "APP_SUCCESS_TOAST_ENABLED", "type": "BOOLEAN", "userId": null, "value": true}, {"id": "41877", "label": "Ativar toast de erro", "name": "APP_ERROR_TOAST_ENABLED", "type": "BOOLEAN", "userId": null, "value": true}, {"id": "71925", "label": "Ativar IP local no layout nativo", "name": "APP_LOCAL_IP_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "71926", "label": "Filtrar configurações pelo nome da rede", "name": "APP_CONFIG_FILTER_ENABLED", "type": "BOOLEAN", "userId": null, "value": true}, {"id": "71927", "label": "Ativar serviço de ping", "name": "APP_PING_SERVICE_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "192165", "label": "Ativar verificação de conectividade", "name": "APP_CONNECTIVITY_CHECK_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "154198", "label": "Mostrar quantidade de CDNs", "name": "APP_CDN_COUNT_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "71928", "label": "Ativar modo avião automático", "name": "APP_AIRPLANE_MODE", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "71929", "label": "Timeout do modo avião automático (em segundos)", "name": "APP_AIRPLANE_MODE_TIMEOUT", "type": "INTEGER", "userId": null, "value": 3}, {"id": "71930", "label": "Ativar alertas sonoros", "name": "APP_ALERT_SOUND_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "188797", "label": "Versão do aplicativo", "name": "APP_CURRENT_VERSION", "type": "STRING", "userId": null, "value": "4.5.0"}, {"id": "188798", "label": "Link para download do aplicativo", "name": "APP_DOWNLOAD_URL", "type": "STRING", "userId": null, "value": null}, {"id": "41878", "label": "Usar layout webview", "name": "APP_LAYOUT_WEBVIEW_ENABLED", "type": "BOOLEAN", "userId": null, "value": false}, {"id": "41882", "label": "LAYOUT WEBVIEW (POR SUA CONTA E RISCO)", "name": "APP_LAYOUT_WEBVIEW", "type": "HTML", "userId": null, "value": null}, {"id": "41883", "label": "ANDROID WEBVIEW (POR SUA CONTA E RISCO)", "name": "APP_SUPPORT_BUTTON", "type": "HTML", "userId": null, "value": ""}, {"id": "41884", "label": "PAGINA WEBVIEW (POR SUA CONTA E RISCO)", "name": "APP_WEB_VIEW", "type": "HTML", "userId": null, "value": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>Atendimento Netliss</title>\n<style>\n  html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0a0a0f;\n    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;}\n  #carregando{position:fixed;inset:0;display:flex;flex-direction:column;\n    align-items:center;justify-content:center;gap:18px;color:#8a90a0;font-size:14px;}\n  #carregando img{width:72px;height:72px;border-radius:50%;\n    animation:pulsa 1.4s ease-in-out infinite;}\n  @keyframes pulsa{0%,100%{opacity:.55;transform:scale(.94)}50%{opacity:1;transform:scale(1)}}\n</style>\n</head>\n<body>\n\n<div id=\"carregando\">\n  <img src=\"https://i.imgur.com/xfpgEW4.png\" alt=\"Liss\">\n  <div>Abrindo o atendimento...</div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/gh/TheB171/netliss-widget/widget-netliss-v40.js\"></script>\n\n<script>\n(function(){\n  function ajustar(){\n    var alt = (window.visualViewport && window.visualViewport.height) ? window.visualViewport.height : window.innerHeight;\n    var m = document.getElementById(\"nl-moldura\");\n    if(m){\n      m.style.position = \"fixed\";\n      m.style.top = \"0\";\n      m.style.left = \"0\";\n      m.style.right = \"0\";\n      m.style.bottom = \"auto\";\n      m.style.width = \"100%\";\n      m.style.maxWidth = \"100%\";\n      m.style.height = alt + \"px\";\n      m.style.maxHeight = alt + \"px\";\n      m.style.borderRadius = \"0\";\n      m.style.margin = \"0\";\n    }\n    var ch = document.getElementById(\"nl-chat\");\n    if(ch){\n      ch.style.height = \"100%\";\n      ch.style.maxHeight = \"100%\";\n      ch.style.borderRadius = \"0\";\n      ch.style.display = \"flex\";\n      ch.style.flexDirection = \"column\";\n    }\n    var corpo = document.getElementById(\"nl-corpo\");\n    if(corpo){ corpo.style.flex = \"1 1 auto\"; corpo.style.minHeight = \"0\"; }\n    var entrada = document.querySelector(\"#nl-chat .nl-input\");\n    if(entrada){ entrada.style.flexShrink = \"0\"; }\n    var rodape = document.querySelector(\"#nl-chat .nl-rodape\");\n    if(rodape){ rodape.style.flexShrink = \"0\"; rodape.style.paddingBottom = \"6px\"; }\n    var enc = document.getElementById(\"nl-encerrar\");\n    if(enc){ enc.style.flexShrink = \"0\"; }\n  }\n\n  var tentativas = 0;\n  var timer = setInterval(function(){\n    tentativas++;\n    if(typeof nlAbrirChat === \"function\"){\n      clearInterval(timer);\n      var b = document.getElementById(\"nl-bolha\");\n      if(b){ b.style.display = \"none\"; }\n      var t = document.getElementById(\"nl-teaser\");\n      if(t){ t.style.display = \"none\"; }\n      nlAbrirChat(\"app_dtunnel\");\n      var c = document.getElementById(\"carregando\");\n      if(c){ c.style.display = \"none\"; }\n      ajustar();\n      setTimeout(ajustar, 400);\n      window.addEventListener(\"resize\", ajustar);\n      if(window.visualViewport){ window.visualViewport.addEventListener(\"resize\", ajustar); }\n    }\n    if(tentativas > 60){\n      clearInterval(timer);\n      document.getElementById(\"carregando\").innerHTML =\n        \"<div style='text-align:center;padding:24px;color:#8a90a0'>\" +\n        \"Nao consegui abrir o atendimento agora.<br><br>\" +\n        \"<a href='https://www.netliss.com' style='color:#c3f53c'>Tocar aqui para abrir o site</a></div>\";\n    }\n  }, 250);\n})();\n</script>\n\n</body>\n</html>"}]